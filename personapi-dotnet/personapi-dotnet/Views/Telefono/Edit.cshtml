@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Editar Teléfono";
}

<h2>Editar Teléfono</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Num" />
    <div class="form-group">
        <label asp-for="Num"></label>
        <input asp-for="Num" class="form-control" readonly />
        <span asp-validation-for="Num" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Oper"></label>
        <input asp-for="Oper" class="form-control" />
        <span asp-validation-for="Oper" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Duenio"></label>
        <select asp-for="Duenio" class="form-control" asp-items="ViewBag.Personas">
            <option value="">Selecciona el dueño</option>
        </select>
        <span asp-validation-for="Duenio" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" asp-controller="Telefonos" class="btn btn-secondary">Cancelar</a>
</form>
