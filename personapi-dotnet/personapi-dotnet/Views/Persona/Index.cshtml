@model IEnumerable<personapi_dotnet.Models.Entities.Persona>

@{
    ViewData["Title"] = "Listado de Personas";
}

<h2>Personas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva Persona</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>CC</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Género</th>
            <th>Edad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var persona in Model)
        {
            <tr>
                <td>@persona.Cc</td>
                <td>@persona.Nombre</td>
                <td>@persona.Apellido</td>
                <td>@persona.Genero</td>
                <td>@persona.Edad</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@persona.Cc" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@persona.Cc" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
