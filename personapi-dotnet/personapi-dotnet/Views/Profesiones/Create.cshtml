@model personapi_dotnet.Models.Entities.Profesion

@{
    ViewData["Title"] = "Crear Profesión";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Nom" class="form-label">Nombre</label>
        <input asp-for="Nom" class="form-control" />
        <span asp-validation-for="Nom" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Des" class="form-label">Descripción</label>
        <input asp-for="Des" class="form-control" />
        <span asp-validation-for="Des" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
