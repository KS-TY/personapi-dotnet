@model IEnumerable<personapi_dotnet.Models.Entities.Profesion>

@{
    ViewData["Title"] = "Lista de Profesiones";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva Profesión</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var profesion in Model)
        {
            <tr>
                <td>@profesion.Id</td>
                <td>@profesion.Nom</td>
                <td>@profesion.Des</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@profesion.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@profesion.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
