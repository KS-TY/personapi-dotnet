@model personapi_dotnet.Models.Entities.Profesion

@{
    ViewData["Title"] = "Eliminar Profesión";
}

<h2>Eliminar Profesión</h2>

<h4>¿Estás seguro que deseas eliminar esta profesión?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nom</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Des</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
