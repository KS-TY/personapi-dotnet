@model personapi_dotnet.Models.Entities.Estudios

@{
    ViewData["Title"] = "Editar Estudio";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <!-- Campos ocultos con las claves primarias -->
    <input type="hidden" asp-for="IdProf" />
    <input type="hidden" asp-for="CcPer" />

    <div class="form-group">
        <label for="Fecha">Fecha</label>
        <input asp-for="Fecha" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Univer">Universidad</label>
        <input asp-for="Univer" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" asp-controller="Telefonos" class="btn btn-secondary">Cancelar</a>
</form>
