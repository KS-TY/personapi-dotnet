@model personapi_dotnet.Models.Entities.Estudios

@{
    ViewData["Title"] = "Eliminar Estudio";
}

<h2>¿Estás seguro de que deseas eliminar este estudio?</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Persona:</dt>
        <dd class="col-sm-10">@Model.CcPerNavigation?.Nombre</dd>

        <dt class="col-sm-2">Profesión:</dt>
        <dd class="col-sm-10">@Model.IdProfNavigation?.Nom</dd>

        <dt class="col-sm-2">Fecha:</dt>
        <dd class="col-sm-10">
            @(Model.Fecha.HasValue ? Model.Fecha.Value.ToShortDateString() : "Sin fecha")
        </dd>


        <dt class="col-sm-2">Universidad:</dt>
        <dd class="col-sm-10">@Model.Univer</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdProf" />
    <input type="hidden" asp-for="CcPer" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
